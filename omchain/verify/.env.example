# คัดลอกไปเป็น .env ที่รากของ repo แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว)
# ค่าจริงอยู่ใน creds/ ของ repo tc-infi ไม่ได้อยู่ในนี้

# AUTH_SECRET ของ ecw — สคริปต์ที่เรียก wallet_transfer ต้องใช้
OMCHAIN_ECW_KEY=

# รหัสผ่าน MySQL ของ ecw — ใช้ตอนอ่านรายชื่อกระเป๋าออกมาทดสอบ
OMCHAIN_ECW_DB_PASSWORD=

# ปลายทาง RPC ของ omtx.py (ไม่ใส่ก็ได้ default 127.0.0.1:8545)
OMTX_RPC=
OMTX_CHAIN_ID=1246
